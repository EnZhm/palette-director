The recolour maths is a faithful port of the Palette Director UI mock v2
(lockColour / mapA / mapB / lumaMatch / luma).  Mode 0 = gradient map,
mode 1 = duotone (first + last colour).  The rotation offset is applied
CPU-side by rotating the uploaded colour array, never in the shader.
*****************************************************************************/

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float4 palA[8];
uniform int nA;
uniform int modeA;
uniform float4 palB[8];
uniform int nB;
uniform int modeB;
uniform float pfade;
uniform float amt;
uniform float contrast;
uniform float preserve;
/* v1 amendments: scalars appended after the original uniforms (D3D11 cbuffer packing,
 * tests/test_cbuffer_layout.cpp) */
uniform float in_black;
uniform float in_white;
uniform int bsrc;

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

/* Colour space: the filter declares OBS_SOURCE_SRGB, so under linear-sRGB
 * rendering OBS hands us linearised texels and expects linear output. The
 * maths and palette hex values are gamma (sRGB) space, so convert in, map,
 * convert back. Palette uniforms are uploaded as gamma-space hex values. */
float3 srgbToLinear(float3 c)
{
	float3 lo = c / 12.92;
	float3 hi = pow((max(c, 0.0) + 0.055) / 1.055, 2.4);
	return lerp(hi, lo, step(c, 0.04045));
}

float3 linearToSrgb(float3 c)
{
	float3 lo = c * 12.92;
	float3 hi = 1.055 * pow(max(c, 0.0), 1.0 / 2.4) - 0.055;
	return lerp(hi, lo, step(c, 0.0031308));
}

float luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

/* "Brightness from": 0 perceived (Rec.709), 1 max(r,g,b), 2 average */
float brightness(float3 c)
{
	if (bsrc == 1)
		return max(c.r, max(c.g, c.b));
	if (bsrc == 2)
		return (c.r + c.g + c.b) / 3.0;
	return luma(c);
}

float3 lumaMatch(float3 c, float l)
{
	return clamp(c * (l / max(luma(c), 0.002)), 0.0, 1.0);
}

float3 mapA(float l)
{
	if (modeA == 1)
		return lerp(palA[0].rgb, palA[nA - 1].rgb, smoothstep(0.0, 1.0, l));
	float x = l * float(nA - 1);
	int i = min(int(floor(x)), nA - 2);
	return lerp(palA[i].rgb, palA[i + 1].rgb, x - float(i));
}

float3 mapB(float l)
{
	if (modeB == 1)
		return lerp(palB[0].rgb, palB[nB - 1].rgb, smoothstep(0.0, 1.0, l));
	float x = l * float(nB - 1);
	int i = min(int(floor(x)), nB - 2);
	return lerp(palB[i].rgb, palB[i + 1].rgb, x - float(i));
}

float3 lockColour(float3 src)
{
	/* input range first (black..white -> 0..1), then contrast */
	float l = saturate((brightness(src) - in_black) / max(in_white - in_black, 0.01));
	l = clamp((l - 0.5) * contrast + 0.5, 0.0, 1.0);
	float3 m = lerp(mapA(l), mapB(l), pfade);
	return lerp(m, lumaMatch(m, l), preserve);
}

float4 PSLockColour(VertData vert_in) : TARGET
{
	float4 src = image.Sample(textureSampler, vert_in.uv);
	float3 g = linearToSrgb(src.rgb);
	float3 col = lerp(g, lockColour(g), amt);
	return float4(srgbToLinear(col), src.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSLockColour(vert_in);
	}
}
